{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bun lint:fix",
            "timeout": 600,
            "statusMessage": "Linting the workspace"
          },
          {
            "type": "command",
            "command": "bun check:dupes",
            "timeout": 600,
            "statusMessage": "Finding duplicate code"
          }
        ]
      }
    ]
  }
}
