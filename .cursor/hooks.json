{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node scripts/hooks/block-git-hook-bypass.ts",
        "failClosed": true
      }
    ],
    "afterFileEdit": [
      {
        "command": "bun lint:fix"
      }
    ],
    "preToolUse": [
      {
        "command": "bash -c 'bun lint:fix 2>&1 | tail -50 >&2; exit ${PIPESTATUS[0]}'",
        "timeout": 5
      }
    ]
  }
}
