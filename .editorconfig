# Matches the oxfmt config (ultracite/oxfmt). oxfmt stays the source of truth.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 80

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false
max_line_length = off

[Makefile]
indent_style = tab
