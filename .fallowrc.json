{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "src/index.{ts,tsx,js,jsx}",
    "src/main.{ts,tsx,js,jsx}",
    "apps/expo/tamagui.config.ts"
  ],
  "workspaces": {
    "patterns": ["apps/*", "packages/*"]
  },
  "ignorePatterns": ["repos/**"],
  "ignoreExports": [
    {
      "file": "apps/spa/**/components/ui/**",
      "exports": ["*"]
    },
    {
      "file": "vitest.msw.ts",
      "exports": ["*"]
    },
    {
      "file": "apps/spa/src/features/master-design/**",
      "exports": ["*"]
    }
  ],
  "overrides": [
    {
      "files": ["apps/spa/**/components/ui/**"],
      "rules": {
        "unused-files": "off",
        "unused-types": "off"
      }
    },
    {
      "files": [
        "apps/spa/pwa-assets.config.ts",
        "apps/spa/src/app/sw.ts",
        "apps/spa/src/hooks/**",
        "apps/expo/src/test/react-native-mmkv-stub.ts",
        "apps/expo/src/shared/constants/**",
        "oxfmt.config.ts",
        "oxlint.config.ts",
        "stryker.config.mjs",
        "scripts/security/**",
        "vitest.msw-setup.ts"
      ],
      "rules": {
        "unused-files": "off"
      }
    }
  ],
  "duplicates": {
    "minOccurrences": 3,
    "ignore": [
      "apps/spa/src/features/auth/hooks/use-auth-login.ts",
      "apps/spa/src/providers/i18n/context.tsx"
    ]
  },
  "health": {
    "ignore": [
      "oxlint.config.ts",
      "**/pwa-assets.config.ts",
      "**/routeTree.gen.ts",
      "**/*.gen.ts",
      "**/components/ui/**",
      "apps/spa/src/features/master-design/**",
      "**/*.{test,spec}.{ts,tsx}",
      "**/e2e/**",
      "scripts/security/**"
    ],
    "thresholdOverrides": []
  },
  "ignoreDependencies": [
    "@stryker-mutator/core",
    "@stryker-mutator/vitest-runner",
    "@opentelemetry/semantic-conventions",
    "msw",
    "postcss-load-config",
    "workbox-core",
    "@expo-google-fonts/space-grotesk",
    "@expo/metro-config",
    "@tamagui/animations-moti",
    "burnt",
    "expo-atlas",
    "expo-dev-client",
    "expo-system-ui",
    "babel-plugin-react-compiler",
    "metro-minify-terser",
    "oxlint-plugin-react-doctor",
    "tailwindcss"
  ],
  "rules": {
    "boundary-violation": "error"
  }
}
