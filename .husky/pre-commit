#!/bin/sh
# Check if there are any staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$STAGED_FILES" ]; then
  echo "No staged files to format"
  exit 0
fi

# Run ultracite + fallow fix in parallel
ULTRACITE_EXIT=0
FALLOW_EXIT=0

bun x ultracite fix &
ULTRACITE_PID=$!

bun check:fix &
FALLOW_PID=$!

wait $ULTRACITE_PID || ULTRACITE_EXIT=$?
wait $FALLOW_PID || FALLOW_EXIT=$?

# Re-stage files that were already staged
echo "$STAGED_FILES" | while IFS= read -r file; do
  if [ -f "$file" ]; then
    git add -- "$file"
  fi
done

EXIT_CODE=0
if [ $ULTRACITE_EXIT -ne 0 ]; then
  echo "Ultracite found issues that could not be auto-fixed."
  EXIT_CODE=$ULTRACITE_EXIT
fi
if [ $FALLOW_EXIT -ne 0 ]; then
  echo "Fallow found issues that could not be auto-fixed."
  EXIT_CODE=$FALLOW_EXIT
fi

if [ $EXIT_CODE -ne 0 ]; then
  exit $EXIT_CODE
fi

echo "✨ Files fixed by Ultracite + Fallow"
