{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "module": "esnext",
    "paths": {
      // "react": [
      //   "./node_modules/@types/react"
      // ],
      "*": ["./*"],
      "@/*": ["./src/*"],
      // Mirrors the `@test/msw` alias in vitest.config.ts.
      "@test/msw": ["../../vitest.msw.ts"],
      "@workspace/core/*": ["../../packages/core/src/*"]
    },
    "strict": true
  },
  "include": [
    "**/*.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
