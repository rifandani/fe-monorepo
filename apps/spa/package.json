    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-web": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.44.0",
    "@reactuses/core": "6.6.1",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.105.1",
    "@tanstack/react-router": "1.170.46",
    "@unhead/react": "3.4.3",
    "@unhead/schema-org": "3.4.3",
    "@workspace/core": "workspace:*",
    "cn": "0.5.1",
    "effect": "4.1.2",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "motion": "14.9.0",
    "radashi": "13.0.1",
    "react": "19.3.1",
    "react-aria": "3.53.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-icons": "5.7.0",
    "react-stately": "3.51.0",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-variants": "4.0.1",
    "tw-animate-css": "1.4.0",
    "type-fest": "5.10.0",
    "web-vitals": "6.2.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/devtools-vite": "0.8.6",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-form-devtools": "0.2.34",
    "@tanstack/react-query-devtools": "5.105.1",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/router-plugin": "1.168.48",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vite-pwa/assets-generator": "2.0.0",
