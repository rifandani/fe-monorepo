{
  "name": "@workspace/spa",
  "version": "1.1.0",
  "private": true,
  "description": "Bulletproof React.js 19 Template",
  "license": "MIT",
  "author": "Tri Rizeki Rifandani",
  "type": "module",
  "scripts": {
    "sitemap:gen": "bun scripts/gen-sitemap.ts",
    "pwa-assets:gen": "pwa-assets-generator",
    "typecheck": "tsc --noEmit",
    "typerange": "fr",
    "typerange:audit": "fr --audit",
    "test:install": "playwright install --with-deps chromium",
    "test:report": "dotenvx run --env-file=.env.local -- playwright show-report",
    "test": "dotenvx run --env-file=.env.local -- playwright test",
    "test:ui": "dotenvx run --env-file=.env.local -- playwright test --ui --headed",
    "test:ci": "dotenvx run --env-file=.env.local -- playwright test --forbid-only",
    "test:unit": "vitest run --project spa",
    "check-site-meta": "bunx check-site-meta 3001 -p 3051",
    "dev": "portless run --name spa.fe-monorepo vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "build-and-preview": "bun run --sequential build preview"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "2.32.3",
    "@heroicons/react": "2.2.0",
    "@internationalized/date": "3.12.4",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/instrumentation": "0.222.0",
    "@opentelemetry/instrumentation-fetch": "0.222.0",
    "@opentelemetry/opentelemetry-browser-detector": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-trace-web": "2.11.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@reactuses/core": "6.5.9",
    "@t3-oss/env-core": "0.13.11",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-router": "1.170.41",
    "@unhead/react": "3.4.2",
    "@unhead/schema-org": "3.4.2",
    "@workspace/core": "workspace:*",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "ky": "2.1.0",
    "motion": "13.5.0",
    "radashi": "12.9.6",
    "react": "19.3.0",
    "react-aria": "3.52.1",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0",
    "react-stately": "3.50.0",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "ts-pattern": "5.9.0",
    "tw-animate-css": "1.4.0",
    "type-fest": "5.10.0",
    "web-vitals": "6.2.2",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-form-devtools": "0.2.34",
    "@tanstack/react-query-devtools": "5.104.0",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/router-plugin": "1.168.42",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vite-pwa/assets-generator": "1.0.4",
    "@vitejs/plugin-react": "6.1.1",
    "@workspace/typescript-config": "workspace:*",
    "agentation": "3.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "rollup-plugin-visualizer": "7.1.1",
    "sitemap": "9.0.1",
    "tailwindcss": "4.3.3",
    "tailwindcss-react-aria-components": "2.2.0",
    "vite": "8.3.2",
    "vite-plugin-pwa": "1.3.0",
    "workbox-build": "7.4.1",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
