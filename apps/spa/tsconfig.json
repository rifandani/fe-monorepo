{
  "extends": "@workspace/typescript-config/react.json",
  "compilerOptions": {
    "paths": {
      "react": ["./node_modules/@types/react"],
      "@/*": ["./src/*"],
      // Mirrors the `@test/arbitraries` alias in vitest.config.ts.
      "@test/arbitraries": ["../../vitest.arbitraries.ts"]
    },
    "resolveJsonModule": true,
    "types": ["vite/client", "react"]
  },
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ],
  "include": ["**/*.js", "**/*.jsx", "**/*.ts", "**/*.tsx", "**/*.json"],
  "exclude": [
    "node_modules",
    "dev-dist",
    "dist",
    "vite.config.*",
    "vitest.e2e.config.*",
    "pwa-assets.config.*"
  ]
}
