{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "spa in node for vite & vitest route tests",
  "compilerOptions": {
    "composite": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "vite.config.*",
    "vitest.e2e.config.*",
    "e2e/support/constants.ts",
    "pwa-assets.config.*"
  ]
}
