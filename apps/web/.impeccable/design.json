  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Default action. Helm Blue fill, no hover-lift, focus ring is the craft.",
      "html": "<button class=\"ds-btn-primary\" type=\"button\">Sign in</button>",
      "css": ".ds-btn-primary{--btn-border:color-mix(in oklab,var(--fg) 15%,transparent);--btn-bg:var(--primary);--btn-fg:var(--primary-fg);--btn-overlay:color-mix(in oklab,var(--primary-fg) 10%,var(--primary) 90%);--btn-ring:color-mix(in oklab,var(--primary) 20%,transparent);display:inline-flex;align-items:center;justify-content:center;min-height:2.25rem;padding:0.375rem 0.75rem;border:1px solid var(--btn-border);border-radius:0.5rem;background:var(--btn-bg);color:var(--btn-fg);font-family:Geist,ui-sans-serif,system-ui,sans-serif;font-size:0.875rem;font-weight:500;line-height:1.5;cursor:pointer;transition:background 200ms}.ds-btn-primary:hover{background:var(--btn-overlay)}.ds-btn-primary:focus-visible{outline:2px solid var(--btn-bg);outline-offset:2px;box-shadow:0 0 0 3px var(--bg),0 0 0 5px var(--btn-ring)}.ds-btn-primary:disabled{opacity:0.5;cursor:default}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Quiet chrome action. Fog fill, muted icons.",
      "html": "<button class=\"ds-btn-secondary\" type=\"button\">Cancel</button>",
      "css": ".ds-btn-secondary{--btn-border:color-mix(in oklab,var(--fg) 15%,transparent);--btn-bg:var(--secondary);--btn-fg:var(--secondary-fg);--btn-overlay:color-mix(in oklab,var(--secondary-fg) 10%,var(--secondary) 90%);--btn-ring:color-mix(in oklab,var(--muted-fg) 20%,transparent);display:inline-flex;align-items:center;justify-content:center;min-height:2.25rem;padding:0.375rem 0.75rem;border:1px solid var(--btn-border);border-radius:0.5rem;background:var(--btn-bg);color:var(--btn-fg);font-family:Geist,ui-sans-serif,system-ui,sans-serif;font-size:0.875rem;font-weight:500;line-height:1.5;cursor:pointer;transition:background 200ms}.ds-btn-secondary:hover{background:var(--btn-overlay)}.ds-btn-secondary:focus-visible{outline:2px solid var(--secondary-fg);outline-offset:2px;box-shadow:0 0 0 3px var(--bg),0 0 0 5px var(--btn-ring)}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Transparent fill, Hairline border, Fog hover wash.",
      "html": "<button class=\"ds-btn-outline\" type=\"button\">Register</button>",
      "css": ".ds-btn-outline{display:inline-flex;align-items:center;justify-content:center;min-height:2.25rem;padding:0.375rem 0.75rem;border:1px solid var(--border);border-radius:0.5rem;background:transparent;color:var(--fg);font-family:Geist,ui-sans-serif,system-ui,sans-serif;font-size:0.875rem;font-weight:500;line-height:1.5;cursor:pointer;transition:background 200ms}.ds-btn-outline:hover{background:var(--secondary)}.ds-btn-outline:focus-visible{outline:2px solid var(--ring);outline-offset:2px;box-shadow:0 0 0 3px var(--bg),0 0 0 5px color-mix(in oklab,var(--ring) 20%,transparent)}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Transparent fill, Input Stroke, 3px Helm ring on focus.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">Email</span><input class=\"ds-input\" type=\"email\" placeholder=\"vaandani@email.com\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:0.5rem;font-family:Geist,ui-sans-serif,system-ui,sans-serif}.ds-field-label{font-size:0.875rem;font-weight:500;line-height:1.5;color:var(--fg)}.ds-input{width:100%;appearance:none;border:1px solid var(--input);border-radius:0.5rem;background:transparent;color:var(--fg);padding:0.375rem 0.75rem;font-size:0.875rem;line-height:1.5;outline:none;transition:border-color 200ms,box-shadow 200ms}.ds-input::placeholder{color:var(--muted-fg)}.ds-input:hover{border-color:color-mix(in oklab,var(--muted-fg) 30%,transparent)}.ds-input:focus{border-color:color-mix(in oklab,var(--ring) 70%,transparent);box-shadow:0 0 0 3px color-mix(in oklab,var(--ring) 20%,transparent)}.ds-input:user-invalid{border-color:color-mix(in oklab,var(--danger-subtle-fg) 70%,transparent)}.ds-input:disabled{background:var(--muted);opacity:0.5}"
    },
    {
      "name": "Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Paper surface, Hairline, resting-edge shadow, 24px gutter.",
      "html": "<article class=\"ds-card\"><header class=\"ds-card-header\"><h3 class=\"ds-card-title\">Session</h3><p class=\"ds-card-desc\">Signed in as the demo user.</p></header><div class=\"ds-card-body\">Wiring stays visible. Demo screens stay thin.</div></article>",
      "css": ".ds-card{display:flex;flex-direction:column;gap:1.5rem;padding:1.5rem 0;border:1px solid var(--border);border-radius:0.5rem;background:var(--card);color:var(--card-fg);box-shadow:0 1px 2px 0 rgb(0 0 0 / 0.05);font-family:Geist,ui-sans-serif,system-ui,sans-serif}.ds-card-header,.ds-card-body{padding:0 1.5rem}.ds-card-title{margin:0;font-size:1rem;font-weight:600;line-height:1.5;color:var(--fg)}.ds-card-desc{margin:0.25rem 0 0;font-size:0.875rem;line-height:1.5;color:var(--muted-fg)}.ds-card-body{font-size:0.875rem;line-height:1.5;color:var(--muted-fg)}"
    },
    {
      "name": "Primary Badge",
      "kind": "chip",
      "refersTo": "badge-primary",
      "description": "Default pill chip. Helm Wash, not a solid primary fill.",
      "html": "<span class=\"ds-badge\">Session</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;gap:0.375rem;height:1.25rem;padding:0 7px;border:1px solid transparent;border-radius:9999px;background:var(--primary-subtle);color:var(--primary-subtle-fg);font-family:Geist,ui-sans-serif,system-ui,sans-serif;font-size:0.75rem;font-weight:500;line-height:1.25;transition:background 200ms}.ds-badge:hover,.ds-badge:focus-visible{background:color-mix(in oklab,var(--primary) 20%,transparent)}.ds-badge:focus-visible{outline:2px solid var(--ring);outline-offset:2px}"
    },
    {
      "name": "Navbar Item",
      "kind": "nav",
      "refersTo": "button-plain",
      "description": "Medium 14px item. Hover Fog. Current is Cool Graphite, not a primary wash.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-item\" href=\"#\">Home</a><a class=\"ds-nav-item ds-nav-item-current\" href=\"#\" aria-current=\"page\">Login</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:0.625rem;font-family:Geist,ui-sans-serif,system-ui,sans-serif}.ds-nav-item{display:inline-flex;align-items:center;padding:0.5rem 0.625rem;border-radius:0.5rem;color:var(--muted-fg);font-size:0.875rem;font-weight:500;line-height:1.25;text-decoration:none;transition:background 200ms,color 200ms}.ds-nav-item:hover{background:var(--secondary);color:var(--secondary-fg)}.ds-nav-item:focus-visible{outline:none;box-shadow:inset 0 0 0 1px var(--ring),0 0 0 2px color-mix(in oklab,var(--ring) 20%,transparent)}.ds-nav-item-current{color:var(--fg)}"
    },
    {
      "name": "Note",
      "kind": "custom",
      "refersTo": "note",
      "description": "In-flow status callout. Subtle wash, 15% current-color border, circular indicator.",
      "html": "<div class=\"ds-note ds-note-danger\" role=\"status\"><span class=\"ds-note-indicator\" aria-hidden=\"true\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm1 14h-2v-2h2v2zm0-4h-2V6h2v6z\"/></svg></span><p class=\"ds-note-body\">Invalid credentials. Check username and password.</p></div>",
      "css": ".ds-note{display:grid;grid-template-columns:auto 1fr;align-items:center;gap:0.75rem;width:100%;padding:1rem;border:1px solid color-mix(in oklab,currentColor 15%,transparent);border-radius:0.5rem;font-family:Geist,ui-sans-serif,system-ui,sans-serif;font-size:0.875rem;line-height:1.5;backdrop-filter:blur(40px)}.ds-note-danger{background:var(--danger-subtle);color:var(--danger-subtle-fg)}.ds-note-indicator{display:grid;place-content:center;width:2rem;height:2rem;border:2px solid color-mix(in oklab,currentColor 40%,transparent);border-radius:9999px}.ds-note-body{margin:0}"
    }
  ],
  "narrative": {
    "northStar": "The Engine Room",
    "overview": "This is an Operate-mode system. Engineers are below deck with the machinery — App Router, Better Auth, Drizzle, observability — not in a showroom. The kit is cool, operational, and restrained: Geist with one saturated helm signal, surfaces that rest flat and lift only when they float.\n\nAccessibility is product truth, not a coat of paint. React Aria focus rings, 44px touch targets, and forced-colors fallbacks are part of the craft. Demo screens stay thin; the wiring is the proof surface.\n\nVisual rejections confirmed by the incumbent kit and the chosen world: marketing-landing spectacle, neon accents, skeuomorphism, decorative illustration, and hover-lift theater.",
    "keyCharacteristics": [
      "One accent (Helm Blue). Status colors are machinery lights, not brand.",
      "Geist + Geist Mono. No display serif, no second sans. (@theme still lists Inter as leftover kit copy — do not load it.)",
      "Soft-rect 8px default. Pills only for badges, toggles, and circular icon buttons.",
      "Hybrid depth: tone + hairline at rest; shadow only on overlays.",
      "Light and dark as equal citizens. Primary chroma does not shift.",
      "16px body on mobile, 14px from sm up. Page titles stay in the 1.25–1.5rem band.",
      "One Geist Mono welcome line on authenticated home is the console tell — not a second body face."
    ],
    "rules": [
      {
        "name": "The One Voice Rule",
        "body": "Helm Blue occupies ≤10% of any given screen. Its rarity is the point. Never wash a whole view in primary.",
        "section": "colors"
      },
      {
        "name": "The Same-Signal Rule",
        "body": "Helm Blue does not change chroma between light and dark. Only surfaces invert.",
        "section": "colors"
      },
      {
        "name": "The Status-Is-Not-Brand Rule",
        "body": "Teal, vermillion, and amber never appear as decorative chrome. They mean a state.",
        "section": "colors"
      },
      {
        "name": "The No-Hero Type Rule",
        "body": "There is no 3–4rem display scale in this system. If a screen needs spectacle type, the screen is in the wrong mode.",
        "section": "typography"
      },
      {
        "name": "The Two-Size Body Rule",
        "body": "Body is 16px on mobile and 14px from sm. Do not mix a third body size in the same view.",
        "section": "typography"
      },
      {
        "name": "The One-Line Console Rule",
        "body": "Geist Mono as display-size type is allowed once: the authenticated home welcome. Do not set paragraphs or forms in mono.",
        "section": "typography"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "Surfaces are flat at rest. Shadows appear only as a response to floating (overlay) or to the login sample pane.",
        "section": "elevation"
      },
      {
        "name": "The Ring-Over-Glow Rule",
        "body": "Focus and hover never use colored drop-shadows. Use a 2–3px ring at 20% Helm Blue (or the intent color).",
        "section": "elevation"
      },
      {
        "name": "The Soft-Rect Rule",
        "body": "8px is the default corner. Pills are for badges, toggles, and circular icon buttons only.",
        "section": "shapes"
      }
    ],
    "dos": [
      "Do keep Helm Blue rare (The One Voice Rule) and identical across themes (The Same-Signal Rule).",
      "Do use React Aria focus rings (2px + 20% wash, Paper offset on buttons) as a visible craft detail.",
      "Do default to 8px soft-rects, 24px card gutters, and shadow-xs + Hairline on resting surfaces.",
      "Do step type down at sm (16px → 14px body) and keep a 44px hit area on square icon controls.",
      "Do put status only in Note, Badge, validation, and meter/progress — never as a decorative wash.",
      "Do keep authenticated home thin: title, one mono welcome, theme/i18n/profile controls."
    ],
    "donts": [
      "Don't introduce a second brand hue, a display serif, or a 3rem+ hero type scale.",
      "Don't lift cards or buttons on hover (translateY, colored drop-shadows, skeuomorphic bevels).",
      "Don't use shadow-2xl outside the login sample pane.",
      "Don't paint marketing-landing spectacle, neon, or illustration into app chrome.",
      "Don't fabricate end-user brand claims, testimonials, or a WCAG certification level.",
      "Don't load Inter alongside Geist. One sans."
    ]
  }
