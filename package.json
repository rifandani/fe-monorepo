{
  "name": "fe-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "React.js and Expo Monorepo Template",
  "license": "MIT",
  "author": "Tri Rizeki Rifandani",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "husky && effect-tsgo patch --no-typescript --oxlint",
    "compose:up": "docker compose -f docker/docker-compose.yml up --build",
    "clean": "rimraf --glob \"**/node_modules\" \"**/dev-dist\" \"**/dist\" \"**/build\" \"**/html\" \"**/playwright\" \"**/playwright-report\" \"**/playwright-test-results\" \"**/bun.lock\" \"**/.next\" \"**/.tanstack\" \"**/.expo\" \"**/.tamagui\" && bun pm cache rm && bun install",
    "bump:deps": "bunx npm-check-updates --workspaces -u --peer -x expo*,@expo*,@dev-plugins*,@babel*,metro*,react-native*,@react-navigation*,tamagui,@tamagui*",
    "bump:ui": "bunx shadcn@latest add @intentui/all -o -c apps/spa",
    "cs": "changeset",
    "cs:v": "changeset version",
    "lint": "ultracite check --disable-nested-config",
    "lint:fix": "ultracite fix --disable-nested-config",
    "lint:doctor": "ultracite doctor",
    "check:health": "fallow health --css --top 10 --quiet",
    "check:dead-code": "fallow dead-code --quiet",
    "check:dupes": "fallow dupes --mode semantic --quiet",
    "check:security": "fallow security --surface  --quiet",
    "check:security:survivors": "fallow security --format json --quiet -o node_modules/.cache/fallow-security.json && fallow security survivors --candidates node_modules/.cache/fallow-security.json --verdicts .fallow/security-verdicts.json --require-verdict-for-each-candidate",
    "audit:sca": "node scripts/security/sca-gate.ts",
    "zap:spa:serve": "VITE_API_BASE_URL=http://127.0.0.1:9/api bun spa build && bun spa preview --port 4100 --strictPort --host",
    "zap:spa": "bun scripts/security/zap.ts spa-baseline",
    "repos:update": "bun scripts/update-vendored-repos.ts",
    "check:all": "fallow --quiet",
    "check:viz": "fallow viz --out .fallow/map.html",
    "check:fix": "fallow fix --yes --no-create-config",
    "typerange": "bun run --parallel core:typerange spa:typerange expo:typerange",
    "core": "bun --elide-lines=0 --filter @workspace/core",
    "spa": "bun --elide-lines=0 --filter @workspace/spa",
    "expo": "bun --elide-lines=0 --filter @workspace/expo",
    "core:typerange": "bun core typerange",
    "spa:typerange": "bun spa typerange",
    "expo:typerange": "bun expo typerange",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:cov": "vitest run --coverage",
    "test:mutate": "stryker run",
    "test:mutate:inc": "stryker run --incremental",
    "core:test:unit": "vitest run --project core",
    "spa:test:unit": "vitest run --project spa",
    "expo:test:unit": "vitest run --project expo"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@chenglou/freerange": "0.0.5",
    "@effect/tsgo": "0.64.1",
    "@effect/vitest": "4.1.2",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@vitest/coverage-v8": "5.1.0",
    "@workspace/typescript-config": "workspace:*",
    "fallow": "3.38.1",
    "husky": "9.1.7",
    "msw": "3.0.3",
    "oxfmt": "0.76.0",
    "oxlint": "1.90.0",
    "oxlint-plugin-react-doctor": "0.9.22",
    "oxlint-tsgolint": "7.0.2005",
    "rimraf": "6.1.4",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "ultracite": "8.1.1",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "3.15.2"
    },
    "@xmldom/xmldom": "0.9.12",
    "body-parser": "1.20.9",
    "browserslist": "4.28.8",
    "compression": "1.8.2",
    "cosmiconfig": {
      "js-yaml": "3.15.2"
    },
    "fast-uri": "3.1.7",
    "js-yaml": "4.3.2",
    "launch-editor": "2.14.2",
    "node-forge": "1.4.1",
    "proxy-addr": "2.0.8",
    "sharp": "0.35.5",
    "shell-quote": "1.11.0",
    "solid-js": "1.9.18",
    "source-map-js": "1.2.2",
    "undici": "6.29.1"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "esbuild",
    "sharp",
    "unrs-resolver"
  ]
}
