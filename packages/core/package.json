{
  "name": "@workspace/core",
  "version": "1.1.1",
  "private": true,
  "description": "Shared core module for React Monorepo",
  "license": "MIT",
  "author": "Tri Rizeki Rifandani",
  "type": "module",
  "exports": {
    "./apis/*": "./src/apis/*.ts",
    "./assets/*": "./src/assets/*",
    "./constants/*": "./src/constants/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./libs/*": "./src/libs/*.ts",
    "./services/*": "./src/services/*.ts",
    "./types/*": "./src/types/*.ts",
    "./utils/*": "./src/utils/*.ts"
  },
  "scripts": {
    "test:unit": "vitest run --project core",
    "typecheck": "tsc --noEmit",
    "typerange": "fr",
    "typerange:audit": "fr --audit"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@workspace/typescript-config": "workspace:*",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "ky": "2.2.0",
    "radashi": "13.0.1",
    "react": ">=19.0.0",
    "type-fest": "5.10.0",
    "zod": "4.6.7"
  }
}
