{
  "name": "@workspace/core",
  "version": "1.1.2",
  "private": true,
  "description": "Shared core module for React Monorepo",
  "license": "MIT",
  "author": "Tri Rizeki Rifandani",
  "type": "module",
  "exports": {
    "./assets/*": "./src/shared/assets/*",
    "./auth/*": "./src/lib/auth/*.ts",
    "./cdn/*": "./src/lib/cdn/*.ts",
    "./constants/*": "./src/shared/constants/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./http/*": "./src/lib/http/*.ts",
    "./i18n/*": "./src/i18n/*.ts",
    "./persistence/*": "./src/lib/persistence/*.ts",
    "./session/*": "./src/lib/session/*.ts",
    "./types/*": "./src/types/*.ts",
    "./utils/*": "./src/utils/*.ts"
  },
  "scripts": {
    "test:unit": "vitest run --project core",
    "typerange": "fr",
    "typerange:audit": "fr --audit",
    "check:boundaries": "fallow architecture --boundaries --quiet"
  },
  "devDependencies": {
    "@effect/atom-react": "4.1.2",
    "@tanstack/react-query": "5.105.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@workspace/typescript-config": "workspace:*",
    "effect": "4.1.2",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@effect/atom-react": "4.1.2",
    "@tanstack/react-query": "5.105.1",
    "effect": "4.1.2",
    "radashi": "13.0.1",
    "react": ">=19.0.0",
    "type-fest": "5.10.0"
  }
}
