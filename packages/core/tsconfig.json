{
  "extends": "@workspace/typescript-config/react-library.json",
  "compilerOptions": {
    // No `rootDir`: this package never emits (the `exports` map points straight at `src/*.ts`), and pinning it to `./src` made `include: ["."]` a TS6059 error
    // on `vitest.config.ts` — which is precisely a file worth checking.
    "noEmit": true,
    "module": "NodeNext",
    "paths": {
      "*": ["./*"],
      "@workspace/core/*": ["./src/*"]
    }
  },
  "include": ["."],
  "exclude": ["node_modules", "dist"]
}
